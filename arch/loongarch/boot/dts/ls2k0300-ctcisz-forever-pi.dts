//		compatible = "jedec,spi-nor";
//		spi-max-frequency = <25000000>;
//		reg = <0>;
//	};
//};

&spi2 {
	status = "okay";

	pinctrl-0 = <&spi2_pins>;
	pinctrl-names = "default";

	dmas =  <&dma 1 0x8e>, <&dma 0 0x8e>;
	dma-names = "tx", "rx";

	#address-cells = <1>;
	#size-cells = <0>;

	flash@0 {
		compatible = "jedec,spi-nor";
		spi-max-frequency = <25000000>;
		reg = <0>;
	};
};

&tsensor {
	status = "okay";
};

&gmac0 {
	status = "okay";

	phy-mode = "rgmii";
	bus_id = <0x00>;
};

&wdt {
	status = "okay";
};

&ehci {
	status = "okay";
};

&ohci {
	status = "okay";
};

&uart0 {
	status = "okay";
};

&i2c0 {
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	es8388: audio-codec@10 {
		compatible = "everest,es8388", "everest,es8328";
		reg = <0x10>;
		clocks = <&es8388_clk>;
		AVDD-supply = <&vcc_3v3>;
		DVDD-supply = <&vcc_3v3>;
		HPVDD-supply = <&vcc_3v3>;
		PVDD-supply = <&vcc_3v3>;
		#sound-dai-cells = <0>;
	};
};

&rtc {
	status = "okay";
};

&dma {
	status = "okay";
};

&i2s {
	status = "okay";

	dmas = <&dma 7 0xbf>, <&dma 6 0xaf>;
	dma-names = "tx", "rx";
};

&emmc {
	status = "okay";

	mmc-hs200-1_8v;
	cap-mmc-highspeed;
	no-sd;
	no-sdio;
	bus-width = <8>;
};

&pinctrl {
	func-spi {
		spi1_pins: spi1-pins {
			pinmux = <PINMUX(60, 0x3)>,
				 <PINMUX(61, 0x3)>,
				 <PINMUX(62, 0x3)>,
				 <PINMUX(63, 0x3)>;
		};

		spi2_pins: spi2-pins {
			pinmux = <PINMUX(64, 0x3)>,
				 <PINMUX(65, 0x3)>,
				 <PINMUX(66, 0x3)>,
				 <PINMUX(67, 0x3)>;
		};
	};
};
