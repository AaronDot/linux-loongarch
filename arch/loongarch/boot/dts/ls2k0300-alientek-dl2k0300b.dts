/dts-v1/;

#include <dt-bindings/gpio/gpio.h>

#include "loongson-2k0300.dtsi"

/ {
	compatible = "alientek,dl2k0300b", "loongson,ls2k0300";
	model = "ATK-DL2K0300B";

	aliases {
		serial0 = &uart0;
	};

	chosen {
		stdout-path = "serial0:115200n8";
	};

	memory@200000 {
		device_type = "memory";
		reg =  <0 0x00200000 0 0x0ee00000
			0 0x90000000 0 0x10000000>;
	};

	reserved-memory {
		#address-cells = <2>;
		#size-cells = <2>;
		ranges;

		linux,cma {
			compatible = "shared-dma-pool";
			reusable;
			size = <0 0x02000000>;
			linux,cma-default;
		};
	};

	sound {
		compatible = "loongson,ls2k0300-dl2k0300b-audio-card";
		model = "Loongson-ASoC";
		mclk-fs = <512>;
		loongson,hp-det-gpios = <&gpio 81 GPIO_ACTIVE_HIGH>;
		loongson,spkr-en-gpios = <&gpio 86 GPIO_ACTIVE_HIGH>;
		loongson,hp-ctl-gpios = <&gpio 87 GPIO_ACTIVE_HIGH>;
		audio-routing =
                        "Headphone", "LOUT1",
                        "Headphone", "ROUT1",
                        "Speaker", "LOUT2",
                        "Speaker", "ROUT2";

		cpu {
			sound-dai = <&i2s>;
		};

		codec {
			sound-dai = <&es8388>;
		};
	};

	vcc_3v3: regulator-vcc-3v3 {
		compatible = "regulator-fixed";
		regulator-name = "VCC_3V3";
		regulator-min-microvolt = <3300000>;
		regulator-max-microvolt = <3300000>;
		regulator-always-on;
		regulator-boot-on;
	};

	es8388_clk: es8388-clock {
		compatible = "fixed-clock";
		clock-frequency = <12288000>;
		#clock-cells = <0>;
	};

	thermal-zones {
		cpu-thermal {
			polling-delay-passive = <1000>;
			polling-delay = <5000>;
			thermal-sensors = <&tsensor 0>;

			trips {
				cpu_alert: cpu-alert {
					temperature = <75000>;
					hysteresis = <5000>;
					type = "active";
				};

				cpu_crit: cpu-crit {
					temperature = <105000>;
					hysteresis = <5000>;
					type = "critical";
				};
			};
		};
	};
};

&tsensor {
	status = "okay";
};

&i2c3 {
	status = "okay";

	pinctrl-0 = <&i2c3_pins>;
	pinctrl-names = "default";

	#address-cells = <1>;
	#size-cells = <0>;

	es8388: es8388@11 {
		compatible = "everest,es8388", "everest,es8328";
		reg = <0x11>;
		clocks = <&es8388_clk>;
		AVDD-supply = <&vcc_3v3>;
		DVDD-supply = <&vcc_3v3>;
		HPVDD-supply = <&vcc_3v3>;
		PVDD-supply = <&vcc_3v3>;
		#sound-dai-cells = <0>;
	};
};

&dma {
	status = "okay";
};

&i2s {
	status = "okay";

	pinctrl-0 = <&i2s_pins>;
	pinctrl-names = "default";

	dmas =  <&dma 7 0xbf>, <&dma 6 0xaf>;
	dma-names = "tx", "rx";
};

&uart0 {
	status = "okay";

	pinctrl-0 = <&uart0_pins>;
	pinctrl-names = "default";
};

&emmc {
	status = "okay";

	cap-mmc-highspeed;
	no-sd;
	no-sdio;
	bus-width = <8>;
};

&sdio {
	status = "okay";

	cap-sd-highspeed;
	cap-mmc-highspeed;
	bus-width = <4>;
};

&wdt {
	status = "okay";
};

&ehci {
	status = "okay";
};

&ohci {
	status = "okay";
};

&gmac0 {
        status = "okay";

	phy-mode = "rgmii-id";
	snps,pbl = <32>;
        phy-handle = <&yt8511h0>;
        mdio {
                compatible = "snps,dwmac-mdio";
                #address-cells = <1>;
                #size-cells = <0>;

                yt8511h0: ethernet-phy@0 {
                        compatible = "ethernet-phy-ieee802.3-c22";
                        reg = <0>;
                        motorcomm,led0_cfg = <0x40>; //千兆常亮
                        motorcomm,led1_cfg = <0x30>; //百兆 十兆常亮
                        motorcomm,led2_cfg = <0x2600>; //有数据时闪烁
                };
        };
};

&gmac1 {
        status = "okay";

	phy-mode = "rgmii-id";
	snps,pbl = <32>;
        phy-handle = <&yt8511h1>;
        mdio {
                compatible = "snps,dwmac-mdio";
                #address-cells = <1>;
                #size-cells = <0>;

                yt8511h1: ethernet-phy@1 {
                        compatible = "ethernet-phy-ieee802.3-c22";
                        reg = <0>;
                        motorcomm,led0_cfg = <0x40>; //千兆常亮
                        motorcomm,led1_cfg = <0x30>; //百兆 十兆常亮
                        motorcomm,led2_cfg = <0x2600>; //有数据时闪烁
                };
        };
};

&rtc {
        status = "okay";
};

&spi0 {
	status = "okay";

	#address-cells = <1>;
	#size-cells = <0>;

	flash@0 {
		compatible = "jedec,spi-nor";
		spi-max-frequency = <25000000>;
		reg = <0>;
	};
};

&pinctrl {
	func-uart {
		uart0_pins: uart0-pins {
			pinmux = <PINMUX(40, 0x3)>,
				 <PINMUX(41, 0x3)>;
		};
	};

	func-timer {
		i2c3_pins: i2c3-pins {
			pinmux = <PINMUX(84, 0x2)>,
				 <PINMUX(85, 0x2)>;
		};
	};

	func-i2s {
		i2s_pins: i2s-pins {
			pinmux = <PINMUX(76, 0x3)>,
				 <PINMUX(77, 0x3)>,
				 <PINMUX(78, 0x3)>,
				 <PINMUX(79, 0x3)>,
				 <PINMUX(80, 0x3)>;
		};
	};
};
